{
  "clientId": "gis-canvas-bff",
  "name": "GIS Canvas BFF",
  "description": "Confidential OIDC client for the GIS Generative Canvas Backend-for-Frontend (Phase 4b). Drives Authorization Code + PKCE against realm 'master'; forwards per-user Bearer tokens to the Data Agent so Denodo VDP enforces per-user entitlements.",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "clientAuthenticatorType": "client-secret",
  "standardFlowEnabled": true,
  "directAccessGrantsEnabled": true,
  "serviceAccountsEnabled": false,
  "implicitFlowEnabled": false,
  "frontchannelLogout": false,
  "fullScopeAllowed": true,
  "redirectUris": [
    "http://localhost:9109/auth/callback"
  ],
  "webOrigins": [
    "http://localhost:5174"
  ],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "http://localhost:5174/*"
  },
  "defaultClientScopes": [
    "web-origins",
    "profile",
    "roles",
    "email"
  ],
  "optionalClientScopes": [
    "offline_access"
  ],
  "protocolMappers": [
    {
      "name": "denodo-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.custom.audience": "denodo",
        "id.token.claim": "false",
        "access.token.claim": "true",
        "introspection.token.claim": "true"
      }
    },
    {
      "name": "denodo-roles-mapper",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-realm-role-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "roles",
        "jsonType.label": "String",
        "multivalued": "true",
        "id.token.claim": "false",
        "access.token.claim": "true",
        "introspection.token.claim": "true",
        "userinfo.token.claim": "false"
      }
    }
  ]
}
