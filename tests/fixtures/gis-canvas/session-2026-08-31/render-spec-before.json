{
  "canvasVersion": 1,
  "layout": {
    "type": "grid",
    "cols": 12,
    "rowHeight": 80,
    "gap": 8
  },
  "components": [
    {
      "id": "suspects",
      "type": "data-table",
      "layer": "base",
      "props": {
        "title": "High-confidence potential_shadow_fleets suspects",
        "columns": [
          "vesselname",
          "imonumber",
          "mmsi_count",
          "first_mmsi",
          "last_mmsi",
          "videos_id"
        ]
      },
      "bindings": {
        "source": "data://73d41e22"
      }
    },
    {
      "id": "coverage",
      "type": "data-table",
      "layer": "dock",
      "edge": "bottom",
      "size": {
        "w": 100,
        "h": 30
      },
      "props": {
        "title": "AIS coverage summary from admin.pg_vessel_positions_select",
        "columns": [
          "vesselname",
          "imonumber",
          "record_count",
          "first_seen",
          "last_seen",
          "distinct_mmsi_count"
        ]
      },
      "bindings": {
        "source": "data://43387491"
      }
    },
    {
      "id": "months",
      "type": "tabs",
      "layer": "dock",
      "edge": "right",
      "size": {
        "w": 34,
        "h": 100
      },
      "props": {
        "tabs": [
          { "id": "clyde", "label": "CLYDE months" },
          { "id": "wonder", "label": "WONDER months" },
          { "id": "trend", "label": "TREND months" },
          { "id": "agni", "label": "AGNI days" }
        ]
      },
      "state": { "active": "clyde" },
      "slots": {
        "clyde": [
          {
            "id": "clyde_months",
            "type": "data-table",
            "props": {
              "title": "CLYDE NOBLE monthly AIS activity",
              "columns": ["month", "record_count", "active_day_count", "first_ts_in_month", "last_ts_in_month"]
            },
            "bindings": { "source": "data://08d4277a" }
          }
        ],
        "wonder": [
          {
            "id": "wonder_months",
            "type": "data-table",
            "props": {
              "title": "WONDER VEGA monthly AIS activity",
              "columns": ["month_label", "record_count", "active_day_count", "first_ts_in_month", "last_ts_in_month"]
            },
            "bindings": { "source": "data://c771b7aa" }
          }
        ],
        "trend": [
          {
            "id": "trend_months",
            "type": "data-table",
            "props": {
              "title": "TREND monthly AIS activity",
              "columns": ["month_label", "record_count", "active_day_count", "first_ts_in_month", "last_ts_in_month"]
            },
            "bindings": { "source": "data://4c10f34c" }
          }
        ],
        "agni": [
          {
            "id": "agni_days",
            "type": "data-table",
            "props": {
              "title": "AGNI daily AIS activity",
              "columns": ["ais_date", "record_count", "first_ts_on_date", "last_ts_on_date"]
            },
            "bindings": { "source": "data://1355b700" }
          }
        ]
      }
    }
  ]
}
